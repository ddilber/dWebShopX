@page "/blog/{Id:int}"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using MediatR
@using dWebShop.Application.Features.Blog.Commands
@using dWebShop.Application.Features.Blog.Queries
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>Edit Post — dWebShop Admin</PageTitle>

@if (_loading)
{
    <FluentProgressRing />
}
else if (_notFound)
{
    <FluentMessageBar Intent="MessageBarIntent.Error">Post not found.</FluentMessageBar>
}
else
{
    <div class="admin-page-head">
        <div>
            <nav class="admin-breadcrumb">
                <a href="/blog">Content</a> › <a href="/blog">Blog</a> › @(_model.Title is { Length: > 0 } t ? t : "Untitled")
            </nav>
            <div class="admin-detail-title-row">
                <h1 class="admin-page-title">@(_model.Title is { Length: > 0 } t2 ? t2 : "Untitled")</h1>
                <span class="pl-badge @(_model.Published ? "pl-badge-active" : "pl-badge-inactive")">
                    @(_model.Published ? "Published" : "Draft")
                </span>
            </div>
        </div>
        <div class="admin-page-actions">
            <FluentButton Appearance="ButtonAppearance.Transparent"
                          IconStart="@(new Icons.Regular.Size16.ArrowLeft())"
                          OnClick="@(() => Navigation.NavigateTo("/blog"))">Back</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Primary"
                          IconStart="@(new Icons.Regular.Size16.Checkmark())"
                          Disabled="@_saving"
                          OnClick="SaveAsync">
                @if (_saving) { <span>Saving…</span> } else { <span>Save changes</span> }
            </FluentButton>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <FluentMessageBar Intent="MessageBarIntent.Error" Style="margin-bottom: 16px;">@_error</FluentMessageBar>
    }
    @if (!string.IsNullOrEmpty(_success))
    {
        <FluentMessageBar Intent="MessageBarIntent.Success" Style="margin-bottom: 16px;">@_success</FluentMessageBar>
    }

    <BlogPostEditor @ref="_editor" Model="_model" AllCategories="_categories" AllTags="_tags" />
}

@code {
    [Parameter] public int Id { get; set; }

    private BlogPostEditor _editor = default!;
    private readonly PostEditModel _model = new();
    private List<PostCategoryDto> _categories = new();
    private List<PostTagDto> _tags = new();
    private string _error = "";
    private string _success = "";
    private bool _loading = true;
    private bool _notFound;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        var post = await Mediator.Send(new GetPostByIdQuery(Id));
        if (post is null)
        {
            _notFound = true;
            _loading = false;
            return;
        }

        _model.Title = post.Title;
        _model.Slug = post.Slug;
        _model.Summary = post.Summary;
        _model.Content = post.Content;
        _model.MetaTitle = post.MetaTitle;
        _model.MetaDescription = post.MetaDescription;
        _model.Published = post.Published;
        _model.CategoryIds = post.Categories.Select(c => c.Id).ToHashSet();
        _model.TagIds = post.Tags.Select(t => t.Id).ToHashSet();

        // Sequential: these handlers share one scoped DbContext and cannot run concurrently.
        _categories = await Mediator.Send(new GetPostCategoriesQuery());
        _tags = await Mediator.Send(new GetPostTagsQuery());

        _loading = false;
    }

    private async Task SaveAsync()
    {
        _error = "";
        _success = "";
        await _editor.ApplyAsync();

        if (string.IsNullOrWhiteSpace(_model.Title))
        {
            _error = "Title is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_model.Slug))
            _model.Slug = SlugHelper.Slugify(_model.Title);

        _saving = true;
        try
        {
            await Mediator.Send(new UpdatePostCommand(
                Id, _model.Title, _model.MetaTitle, _model.Slug, _model.Summary, _model.Content,
                _model.Published, _model.MetaDescription,
                _model.CategoryIds.ToList(), _model.TagIds.ToList()));
            _success = "Post saved.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _saving = false;
    }
}

@page "/clients/new"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using MediatR
@using dWebShop.Application.Features.Partners.Commands
@inject IMediator Mediator
@inject NavigationManager Navigation

<PageTitle>New Client — dWebShop Admin</PageTitle>

<div class="admin-page-head">
    <div>
        <nav class="admin-breadcrumb">
            <a href="/clients">Commerce</a> › <a href="/clients">Clients</a> › New client
        </nav>
        <h1 class="admin-page-title">Create client</h1>
        <p class="admin-page-sub">Add a business or individual you sell to. You can assign pricelists and discounts afterwards.</p>
    </div>
    <div class="admin-page-actions">
        <FluentButton Appearance="ButtonAppearance.Transparent"
                      IconStart="@(new Icons.Regular.Size16.Dismiss())"
                      OnClick="@(() => Navigation.NavigateTo("/clients"))">Discard</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Primary"
                      IconStart="@(new Icons.Regular.Size16.Checkmark())"
                      Disabled="@_saving"
                      OnClick="SaveAsync">
            @if (_saving) { <span>Creating…</span> } else { <span>Create client</span> }
        </FluentButton>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <FluentMessageBar Intent="MessageBarIntent.Error" Style="margin-bottom: 16px;">@_error</FluentMessageBar>
}

<div style="max-width: 640px;">
    <FluentCard>
        <div class="order-card-title" style="margin-bottom: 16px;">Company</div>
        <div class="pl-form-grid">
            <div class="pl-field">
                <label class="co-label" for="cl-company">Company name</label>
                <input id="cl-company" class="co-input" @bind="_companyName" @bind:event="oninput"
                       placeholder="e.g. Gradnja d.o.o." />
                <div class="pl-hint">Leave blank for an individual customer.</div>
            </div>
        </div>
    </FluentCard>

    <FluentCard style="margin-top: 16px;">
        <div class="order-card-title" style="margin-bottom: 16px;">Contact</div>
        <div class="pl-form-grid">
            <div class="pl-form-row">
                <div class="pl-field">
                    <label class="co-label" for="cl-first">First name</label>
                    <input id="cl-first" class="co-input" @bind="_firstName" @bind:event="oninput" />
                </div>
                <div class="pl-field">
                    <label class="co-label" for="cl-last">Last name</label>
                    <input id="cl-last" class="co-input" @bind="_lastName" @bind:event="oninput" />
                </div>
            </div>
            <div class="pl-form-row">
                <div class="pl-field">
                    <label class="co-label" for="cl-email">Email</label>
                    <input id="cl-email" type="email" class="co-input" @bind="_email" @bind:event="oninput"
                           placeholder="name@company.com" />
                </div>
                <div class="pl-field">
                    <label class="co-label" for="cl-phone">Phone</label>
                    <input id="cl-phone" class="co-input" @bind="_phone" @bind:event="oninput" />
                </div>
            </div>
        </div>
    </FluentCard>
</div>

@code {
    private string _firstName = "";
    private string _lastName = "";
    private string _companyName = "";
    private string _email = "";
    private string _phone = "";
    private string _error = "";
    private bool _saving;

    private async Task SaveAsync()
    {
        _error = "";

        if (string.IsNullOrWhiteSpace(_firstName) && string.IsNullOrWhiteSpace(_lastName) && string.IsNullOrWhiteSpace(_companyName))
        {
            _error = "Enter a company name, or a first/last name.";
            return;
        }

        _saving = true;

        try
        {
            var id = await Mediator.Send(new CreatePartnerCommand(_firstName, _lastName, _companyName, _email, _phone));
            Navigation.NavigateTo($"/clients/{id}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _saving = false;
        }
    }
}

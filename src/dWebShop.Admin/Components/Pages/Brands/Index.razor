@page "/brands"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using MediatR
@using dWebShop.Application.Features.Brands.Queries
@using dWebShop.Application.Features.Brands.Commands
@using dWebShop.Admin.Components.Pages.Blog
@inject IMediator Mediator

<PageTitle>Brands — dWebShop Admin</PageTitle>

<div class="admin-page-head">
    <div>
        <nav class="admin-breadcrumb">
            <a href="/products">Catalogue</a> › Brands
        </nav>
        <h1 class="admin-page-title">Brands</h1>
        @if (_brands is not null)
        {
            <p class="admin-page-sub">@_brands.Count brand@(_brands.Count == 1 ? "" : "s")</p>
        }
    </div>
    <div class="admin-page-actions">
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.Add())" OnClick="OpenCreate">
            Add brand
        </FluentButton>
    </div>
</div>

@if (_loading)
{
    <FluentSpinner />
}
else if (_brands is not null)
{
    <FluentDataGrid Items="@_brands.AsQueryable()" TGridItem="BrandDto">
        <PropertyColumn Title="Name" Property="@(b => b.Name)" Sortable="true" />
        <PropertyColumn Title="Slug" Property="@(b => b.Slug)" />
        <TemplateColumn Title="Actions">
            <FluentButton IconStart="@(new Icons.Regular.Size16.Edit())" OnClick="@(() => OpenEdit(context))">Edit</FluentButton>
        </TemplateColumn>
    </FluentDataGrid>
}

@if (_dialogOpen)
{
    <div class="img-picker-overlay" @onclick="CloseDialog">
        <div class="img-picker-dialog" style="width: 480px;" @onclick:stopPropagation="true">
            <div class="img-picker-header">
                <span style="font-size: 18px; font-weight: 600;">@(_editModel.Id == 0 ? "Add Brand" : "Edit Brand")</span>
                <FluentButton Appearance="ButtonAppearance.Transparent" IconStart="@(new Icons.Regular.Size16.Dismiss())" OnClick="CloseDialog" />
            </div>
            <div style="padding: 16px; display: flex; flex-direction: column; gap: 12px;">
                @if (!string.IsNullOrEmpty(_error))
                {
                    <FluentMessageBar Intent="MessageBarIntent.Error">@_error</FluentMessageBar>
                }
                <FluentTextInput @bind-Value="_editModel.Name" Label="Name" Style="width: 100%" />
                <FluentTextInput @bind-Value="_editModel.Slug" Label="Slug" Style="width: 100%" />
                <FluentTextArea @bind-Value="_editModel.Description" Label="Description" Rows="3" Style="width: 100%" />
            </div>
            <div class="img-picker-footer">
                <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@_saving" OnClick="Save">@(_saving ? "Saving…" : "Save")</FluentButton>
                <FluentButton OnClick="CloseDialog">Cancel</FluentButton>
            </div>
        </div>
    </div>
}

@code {
    private List<BrandDto>? _brands;
    private bool _loading = true;
    private bool _dialogOpen;
    private bool _saving;
    private string _error = "";
    private BrandEditModel _editModel = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var result = await Mediator.Send(new GetBrandsQuery());
        _brands = result.ToList();
        _loading = false;
    }

    private void OpenCreate() { _editModel = new(); _error = ""; _dialogOpen = true; }

    private void OpenEdit(BrandDto brand)
    {
        // Logo and slider images aren't editable here, but the update command
        // overwrites them, so carry the stored values through.
        _editModel = new()
        {
            Id = brand.Id, Name = brand.Name, Slug = brand.Slug, Description = brand.Description,
            LogoImage = brand.LogoImage, SliderImage = brand.SliderImage,
        };
        _error = "";
        _dialogOpen = true;
    }

    private void CloseDialog() => _dialogOpen = false;

    private async Task Save()
    {
        _error = "";
        if (string.IsNullOrWhiteSpace(_editModel.Name)) { _error = "Name is required."; return; }
        if (string.IsNullOrWhiteSpace(_editModel.Slug)) _editModel.Slug = SlugHelper.Slugify(_editModel.Name);

        _saving = true;
        try
        {
            if (_editModel.Id == 0)
                await Mediator.Send(new CreateBrandCommand(_editModel.Name, _editModel.Slug, _editModel.Description, "", ""));
            else
                await Mediator.Send(new UpdateBrandCommand(_editModel.Id, _editModel.Name, _editModel.Slug, _editModel.Description,
                    _editModel.LogoImage, _editModel.SliderImage));

            _dialogOpen = false;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        _saving = false;
    }

    private class BrandEditModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Slug { get; set; } = "";
        public string Description { get; set; } = "";
        public string LogoImage { get; set; } = "";
        public string SliderImage { get; set; } = "";
    }
}

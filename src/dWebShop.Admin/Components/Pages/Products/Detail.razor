
@page "/products/{Slug}"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using MediatR
@using dWebShop.Application.Features.Products.Queries
@using dWebShop.Application.Features.Products.Commands
@using dWebShop.Domain.Entities.Products
@using dWebShop.Application.Features.Brands.Queries
@using dWebShop.Application.Features.Categories.Queries
@using dWebShop.Application.Features.ProductSkus.Queries
@using dWebShop.Application.Features.ProductSkus.Commands
@using dWebShop.Admin.Components.Shared
@inject IMediator Mediator
@inject NavigationManager Navigation
@inject IConfiguration Configuration

<PageTitle>@(_isNew ? "New product" : _form.Name) — dWebShop Admin</PageTitle>


<ImagePickerDialog @ref="_imagePicker" OnAccepted="HandleImages" SubFolder="product_images" />
<ImagePickerDialog @ref="_skuImagePicker" OnAccepted="HandleSkuImage" SubFolder="product_images" SingleSelect="true" />

@if (_loading)
{
    <div style="padding: 48px; text-align: center; color: var(--fg-3);">Loading…</div>
}
else
{
    <div class="admin-page-head">
        <div style="display:flex;align-items:center;gap:var(--sp-16)">
            @if (PrimaryImage is not null)
            {
                <img src="@PrimaryImage" alt=""
                     style="width:56px;height:56px;object-fit:cover;border-radius:var(--r-md);border:1px solid var(--stroke-1);flex-shrink:0;" />
            }
            <div>
                <nav class="admin-breadcrumb">
                    <a href="/products">Catalogue</a> › <a href="/products">Products</a> › @(_isNew ? "New product" : _form.Name)
                </nav>
                <h1 class="admin-page-title">@(_isNew ? "New product" : _form.Name)</h1>
                @if (!_isNew && !string.IsNullOrWhiteSpace(_form.Sku))
                {
                    <p class="admin-page-sub">SKU @_form.Sku</p>
                }
            </div>
        </div>
        <div class="admin-page-actions">
            <FluentButton Appearance="ButtonAppearance.Transparent"
                          IconStart="@(new Icons.Regular.Size16.ArrowLeft())"
                          OnClick="@(() => Navigation.NavigateTo("/products"))">Back</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Primary"
                          IconStart="@(new Icons.Regular.Size16.Checkmark())"
                          Disabled="@_saving"
                          OnClick="SaveAsync">
                @if (_saving) { <span>Saving…</span> } else { <span>@(_isNew ? "Create product" : "Save changes")</span> }
            </FluentButton>
        </div>
    </div>

    @if (_error is not null)
    {
        <div style="background:var(--danger-bg);color:var(--danger);border:1px solid var(--danger);border-radius:var(--r-md);padding:var(--sp-12) var(--sp-16);margin-bottom:var(--sp-16);font-size:var(--fs-300)">
            @_error
        </div>
    }
    @if (_saved)
    {
        <div style="background:var(--success-bg);color:var(--success);border:1px solid var(--success);border-radius:var(--r-md);padding:var(--sp-12) var(--sp-16);margin-bottom:var(--sp-16);font-size:var(--fs-300)">
            Product saved successfully.
        </div>
    }

    <!-- Tab row -->
    <div class="ds-tabs" style="margin-bottom: var(--sp-24);">
        <button class="ds-tab @(_activeTab == 0 ? "is-active" : "")" @onclick="@(() => SetTabAsync(0))">General</button>
        <button class="ds-tab @(_activeTab == 1 ? "is-active" : "")" @onclick="@(() => SetTabAsync(1))">Media</button>
        <button class="ds-tab @(_activeTab == 2 ? "is-active" : "")" @onclick="@(() => SetTabAsync(2))">Pricing &amp; Inventory</button>
        <button class="ds-tab @(_activeTab == 3 ? "is-active" : "")" @onclick="@(() => SetTabAsync(3))">Variants</button>
        <button class="ds-tab @(_activeTab == 4 ? "is-active" : "")" @onclick="@(() => SetTabAsync(4))">SEO</button>
    </div>

    <div class="detail-grid">

        <!-- MAIN COLUMN -->
        <div class="detail-main">

            @if (_activeTab == 0)
            {
                <!-- General -->
                <div class="ds-card">
                    <div class="card-head">
                        <div class="card-title">Basic information</div>
                    </div>
                    <div class="form-grid">
                        <div class="field span-2">
                            <label for="prod-product-name" class="field-label">Product name *</label>
                            <input id="prod-product-name" class="ds-input" placeholder="e.g. Premium Wireless Headphones" @bind="_form.Name" />
                        </div>
@*                         <div class="field">
                            <label for="prod-sku" class="field-label">SKU</label>
                            <input id="prod-sku" class="ds-input" placeholder="e.g. PRD-001" @bind="_form.Sku" />
                        </div>
                        <div class="field">
                            <label for="prod-external-reference" class="field-label">External reference</label>
                            <input id="prod-external-reference" class="ds-input" placeholder="e.g. ERP-12345" @bind="_form.ExtRef" />
                        </div>
 *@                        <div class="field span-2">
                            <label for="prod-url-slug" class="field-label">URL slug *</label>
                            <input id="prod-url-slug" class="ds-input" placeholder="e.g. premium-wireless-headphones" @bind="_form.Slug" />
                            <span class="field-hint">Used in product URLs. Lowercase letters, numbers and hyphens only.</span>
                        </div>
                        <div class="field span-2">
                            <label for="prod-short-description" class="field-label">Short description</label>
                            <textarea id="prod-short-description" class="ds-textarea" rows="3" placeholder="Brief product summary shown in listings…" @bind="_form.Description"></textarea>
                        </div>
                        <div class="field span-2">
                            <span class="field-label">Full description</span>
                            @* Keyed by product so the Quill editor remounts with the new HTML when the slug changes. *@
                            <RichTextEditor @key="_loadedSlug" @ref="_detailEditor" Html="@_form.DetailDescription" />
                        </div>
                    </div>
                </div>
            }

            @if (_activeTab == 1)
            {
                <!-- Media -->
                <div class="ds-card">
                    <div class="card-head">
                        <div class="card-title">Product images</div>
@*                         <button class="ds-btn">
                            <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                                <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z"/>
                            </svg>
                            Upload image
                        </button>
 *@                        
                        <FluentButton OnClick="@(async () => await _imagePicker.Show())">
                            <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                                <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
                            </svg>
                            Pick image
                        </FluentButton>

                    </div>
                    @if (_detail?.Images.Count > 0)
                    {
                        <div class="media-grid">
                            @for (var i = 0; i < _detail.Images.Count; i++)
                            {
                                var idx = i;
                                var img = _detail.Images[idx];
                                <div class="media-cell" style="position:relative;">
                                    <img src="@img.Path" alt="@img.Description" />
                                    @if (_pendingImageIdx == idx)
                                    {
                                        <div class="media-overlay" style="opacity:1;flex-direction:column;gap:6px;color:#fff;font-size:var(--fs-200)">
                                            <span>Remove image?</span>
                                            <div style="display:flex;gap:6px">
                                                <button class="media-overlay-btn media-overlay-btn--danger" style="width:auto;padding:0 8px"
                                                        @onclick="@(async () => await RemoveImage(idx))" @onclick:stopPropagation="true">Remove</button>
                                                <button class="media-overlay-btn" style="width:auto;padding:0 8px"
                                                        @onclick="@(() => _pendingImageIdx = null)" @onclick:stopPropagation="true">Keep</button>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                    <div class="media-overlay">
                                        <button class="media-overlay-btn" title="Move left"
                                                disabled="@(idx == 0)"
                                                @onclick="@(async () => await MoveImage(idx, -1))"
                                                @onclick:stopPropagation="true">
                                            <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14"><path d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"/></svg>
                                        </button>
                                        <button class="media-overlay-btn media-overlay-btn--danger" title="Remove"
                                                @onclick="@(() => _pendingImageIdx = idx)"
                                                @onclick:stopPropagation="true">
                                            <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zm-1 7a1 1 0 112 0v3a1 1 0 11-2 0V9zm4 0a1 1 0 10-2 0v3a1 1 0 102 0V9z" clip-rule="evenodd"/></svg>
                                        </button>
                                        <button class="media-overlay-btn" title="Move right"
                                                disabled="@(idx == _detail.Images.Count - 1)"
                                                @onclick="@(async () => await MoveImage(idx, 1))"
                                                @onclick:stopPropagation="true">
                                            <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14"><path d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"/></svg>
                                        </button>
                                    </div>
                                    }
                                </div>
                            }
                            <div class="media-cell media-add" @onclick="@(async () => await _imagePicker.Show())">
                                <svg viewBox="0 0 20 20" fill="currentColor" width="24" height="24">
                                    <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z"/>
                                </svg>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div style="border:2px dashed var(--stroke-1);border-radius:var(--r-lg);padding:48px;text-align:center;color:var(--fg-3)">
                            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48" style="display:block;margin:0 auto 16px;opacity:.4">
                                <rect x="4" y="4" width="40" height="40" rx="8"/>
                                <circle cx="16" cy="18" r="4"/>
                                <path d="M4 32l10-10 8 8 6-6 16 16"/>
                            </svg>
                            <p style="margin:0;font-weight:var(--fw-semibold)">No images yet</p>
                            <p style="margin:8px 0 0;font-size:var(--fs-200)">Click <strong>Pick image</strong> to add one</p>
                        </div>
                    }
                </div>
            }

            @if (_activeTab == 2)
            {
                <!-- Pricing & Inventory -->
                <div class="ds-card">
                    <div class="card-head">
                        <div class="card-title">Pricing &amp; stock</div>
                    </div>
                    @if (_isNew)
                    {
                        <div style="color:var(--fg-3);font-size:var(--fs-300)">Save the product first to manage pricing and stock.</div>
                    }
                    else if (_skus.Count == 0)
                    {
                        <div style="color:var(--fg-3);font-size:var(--fs-300)">No SKUs yet. Add a SKU on the Variants tab to define pricing and stock.</div>
                    }
                    else if (_skus.Count == 1)
                    {
                        @if (_skuPriceError is not null)
                        {
                            <div style="background:var(--danger-bg);color:var(--danger);border:1px solid var(--danger);border-radius:var(--r-md);padding:var(--sp-8) var(--sp-12);margin-bottom:var(--sp-12);font-size:var(--fs-300)">
                                @_skuPriceError
                            </div>
                        }
                        @if (_skuPriceSaved)
                        {
                            <div style="background:var(--success-bg,#f0fdf4);color:var(--success,#16a34a);border:1px solid var(--success,#16a34a);border-radius:var(--r-md);padding:var(--sp-8) var(--sp-12);margin-bottom:var(--sp-12);font-size:var(--fs-300)">
                                Pricing and stock updated.
                            </div>
                        }
                        <div class="form-grid cols-3">
                            <div class="field">
                                <label for="prod-price" class="field-label">Price *</label>
                                <input id="prod-price" class="ds-input" type="number" step="0.01" min="0" placeholder="0.00" @bind="_singleSkuPrice" />
                            </div>
                            <div class="field">
                                <label for="prod-compare-at-price" class="field-label">Compare-at price</label>
                                <input id="prod-compare-at-price" class="ds-input" type="number" step="0.01" min="0" placeholder="0.00" @bind="_singleSkuCompareAtPrice" />
                                <span class="field-hint">Shown as strikethrough</span>
                            </div>
                            <div class="field">
                                <label for="prod-cost-per-item" class="field-label">Cost per item</label>
                                <input id="prod-cost-per-item" class="ds-input" type="number" step="0.01" min="0" placeholder="0.00" @bind="_singleSkuCostPrice" />
                                <span class="field-hint">Not shown to customers</span>
                            </div>
                            <div class="field">
                                <label for="prod-stock-quantity" class="field-label">Stock quantity</label>
                                <input id="prod-stock-quantity" class="ds-input" type="number" min="0" placeholder="0" @bind="_singleSkuStock" />
                            </div>
                            <div class="field">
                                <label for="prod-low-stock-threshold" class="field-label">Low stock threshold</label>
                                <input id="prod-low-stock-threshold" class="ds-input" type="number" min="0" placeholder="5" @bind="_singleSkuLowStock" />
                                <span class="field-hint">Listed under <strong>Low stock</strong> at or below this</span>
                            </div>
                        </div>
                        <div style="margin-top:var(--sp-16)">
                            <button class="ds-btn" style="background:var(--accent-rest);color:white;border-color:var(--accent-rest)" @onclick="SaveSingleSkuPriceAsync" disabled="@_skuPriceSaving">
                                @(_skuPriceSaving ? "Saving…" : "Update pricing & stock")
                            </button>
                        </div>
                    }
                    else
                    {
                        <div style="color:var(--fg-3);font-size:var(--fs-300)">
                            This product has multiple variants. Set prices and stock individually on the <strong>Variants</strong> tab.
                        </div>
                    }
                </div>
            }

            @if (_activeTab == 3)
            {
                <!-- Variants / SKUs -->
                @if (_isNew)
                {
                    <div class="ds-card">
                        <div style="padding: 32px; text-align: center; color: var(--fg-3);">
                            Save the product first, then you can add SKUs.
                        </div>
                    </div>
                }
                else
                {
                    <!-- Options: what the SKUs vary by (e.g. Pakiranje: 5 kg / 25 kg) -->
                    <div class="ds-card">
                        <div class="card-head">
                            <div>
                                <div class="card-title">Options</div>
                                <div class="card-sub">What the SKUs differ by, such as packaging or colour. Each SKU picks one value per option.</div>
                            </div>
                        </div>

                        @if (_optionError is not null)
                        {
                            <div style="background:var(--danger-bg);color:var(--danger);border:1px solid var(--danger);border-radius:var(--r-md);padding:var(--sp-8) var(--sp-12);margin-bottom:var(--sp-12);font-size:var(--fs-300)">
                                @_optionError
                            </div>
                        }

                        @foreach (var opt in _options)
                        {
                            var o = opt;
                            <div class="opt-block">
                                <div class="opt-head">
                                    @if (_editKind == "option" && _editId == o.Id)
                                    {
                                        <input class="ds-input" aria-label="Option name" @bind="_editText" @bind:event="oninput"
                                               @onkeydown="@(e => OnEditKey(e))" />
                                        <button class="ds-btn" disabled="@_optionBusy" @onclick="SaveEditAsync">Save</button>
                                        <button class="ds-btn ds-btn-subtle" @onclick="CancelEdit">Cancel</button>
                                    }
                                    else
                                    {
                                        <span class="opt-name">@o.Name</span>
                                        @if (o.IsNamePart) { <span class="ds-badge ds-badge-neutral" title="The value is used in the SKU name">in name</span> }
                                        <span class="opt-spacer"></span>
                                        @if (_confirmKind == "option" && _confirmId == o.Id)
                                        {
                                            <span class="opt-confirm">Delete option@(OptionUsage(o) > 0 ? $" and clear it from {OptionUsage(o)} SKU{(OptionUsage(o) == 1 ? "" : "s")}" : "")?</span>
                                            <button class="ds-btn" style="color:var(--danger);border-color:var(--danger)" disabled="@_optionBusy"
                                                    @onclick="@(() => DeleteOptionAsync(o.Id))">Delete</button>
                                            <button class="ds-btn ds-btn-subtle" @onclick="@(() => _confirmKind = null)">Keep</button>
                                        }
                                        else
                                        {
                                            <button class="ds-btn ds-btn-subtle" @onclick="@(() => StartEdit("option", o.Id, o.Name))">Rename</button>
                                            <button class="ds-btn ds-btn-subtle" style="color:var(--danger)" @onclick="@(() => AskConfirm("option", o.Id))">Delete</button>
                                        }
                                    }
                                </div>

                                <div class="opt-values">
                                    @foreach (var val in o.Values)
                                    {
                                        var v = val;
                                        var used = ValueUsage(o, v);
                                        if (_editKind == "value" && _editId == v.Id)
                                        {
                                            <span class="opt-chip is-editing">
                                                <input class="ds-input" aria-label="Value name" @bind="_editText" @bind:event="oninput"
                                                       @onkeydown="@(e => OnEditKey(e))" />
                                                <button class="ds-btn" disabled="@_optionBusy" @onclick="SaveEditAsync">Save</button>
                                                <button class="ds-btn ds-btn-subtle" @onclick="CancelEdit">Cancel</button>
                                            </span>
                                        }
                                        else if (_confirmKind == "value" && _confirmId == v.Id)
                                        {
                                            <span class="opt-chip is-confirm">
                                                Delete “@v.Name”@(used > 0 ? $" from {used} SKU{(used == 1 ? "" : "s")}" : "")?
                                                <button class="opt-chip-btn" style="color:var(--danger)" disabled="@_optionBusy" @onclick="@(() => DeleteValueAsync(v.Id))">Delete</button>
                                                <button class="opt-chip-btn" @onclick="@(() => _confirmKind = null)">Keep</button>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="opt-chip" title="@(used > 0 ? $"Used by {used} SKU{(used == 1 ? "" : "s")}" : "Not used by any SKU")">
                                                <button class="opt-chip-label" title="Rename" @onclick="@(() => StartEdit("value", v.Id, v.Name))">@v.Name</button>
                                                @if (used > 0) { <span class="opt-chip-count">@used</span> }
                                                <button class="opt-chip-btn" aria-label="@($"Delete value {v.Name}")" title="Delete" @onclick="@(() => AskConfirm("value", v.Id))">×</button>
                                            </span>
                                        }
                                    }
                                    <span class="opt-add-value">
                                        <input class="ds-input" aria-label="@($"New value for {o.Name}")" placeholder="Add value…"
                                               value="@_newValue.GetValueOrDefault(o.Id)"
                                               @oninput="@(e => _newValue[o.Id] = e.Value?.ToString() ?? "")"
                                               @onkeydown="@(async e => { if (e.Key == "Enter") await AddValueAsync(o.Id); })" />
                                        <button class="ds-btn" disabled="@(_optionBusy || string.IsNullOrWhiteSpace(_newValue.GetValueOrDefault(o.Id)))"
                                                @onclick="@(() => AddValueAsync(o.Id))">Add</button>
                                    </span>
                                </div>
                            </div>
                        }

                        <div class="opt-new">
                            <input class="ds-input" aria-label="New option name" placeholder="New option, e.g. Pakiranje"
                                   @bind="_newOptionName" @bind:event="oninput"
                                   @onkeydown="@(async e => { if (e.Key == "Enter") await AddOptionAsync(); })" />
                            <label class="pl-check" title="Append this option's value to the SKU name">
                                <input type="checkbox" @bind="_newOptionIsNamePart" />
                                <span>Part of SKU name</span>
                            </label>
                            <button class="ds-btn" disabled="@(_optionBusy || string.IsNullOrWhiteSpace(_newOptionName))" @onclick="AddOptionAsync">Add option</button>
                        </div>
                    </div>

                    <div class="ds-card no-pad">
                        <div class="card-head" style="padding: var(--pad-card); padding-bottom: 0;">
                            <div>
                                <div class="card-title">SKUs</div>
                                <div class="card-sub">@_skus.Count SKU@(_skus.Count == 1 ? "" : "s")</div>
                            </div>
                            <button class="ds-btn" @onclick="OpenAddSku">
                                <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14">
                                    <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z"/>
                                </svg>
                                Add SKU
                            </button>
                        </div>

                        @if (_skus.Count == 0 && !_showSkuForm)
                        {
                            <div style="padding: 48px; text-align: center; color: var(--fg-3); border-top: 1px solid var(--stroke-1); margin-top: var(--pad-card);">
                                No SKUs yet. Add a SKU to define pricing and variants.
                            </div>
                        }
                        else if (_skus.Count > 0)
                        {
                            <table class="ds-table" style="margin-top: var(--sp-16);">
                                <thead>
                                    <tr>
                                        <th class="ds-th"></th>
                                        <th class="ds-th">SKU</th>
                                        <th class="ds-th">Name</th>                                        
                                        <th class="ds-th">Options</th>
                                        <th class="ds-th" style="text-align:right">Price</th>
                                        <th class="ds-th" style="text-align:right">Tax %</th>
                                        <th class="ds-th" style="width:80px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sku in _skus)
                                    {
                                        <tr class="ds-tr">
                                            <td class="ds-td">
                                                <div class="tbl-name-cell">
                                                    <div class="tbl-thumb">
                                                        @if (sku.ImagePath is not null)
                                                        {
                                                            <img src="@sku.ImagePath" alt="" />
                                                        }
                                                        else
                                                        {
                                                            <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
                                                                <path d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm0 1.5h12a.5.5 0 01.5.5v6.586l-2.793-2.793a1 1 0 00-1.414 0L9.5 11.586 8.207 10.293a1 1 0 00-1.414 0L3.5 13.793V5a.5.5 0 01.5-.5zm3 3a1 1 0 110 2 1 1 0 010-2z" />
                                                            </svg>
                                                        }
                                                    </div>
                                                </div>
                                            </td>

                                            <td class="ds-td is-mono">@sku.SKU</td>
                                            <td class="ds-td">@sku.Name</td>
                                            <td class="ds-td">
                                                @if (sku.Options.Count > 0)
                                                {
                                                    <div style="display:flex;flex-wrap:wrap;gap:4px">
                                                        @foreach (var opt in sku.Options)
                                                        {
                                                            <span class="ds-badge ds-badge-brand">@opt.OptionName: @opt.OptionValueName</span>
                                                        }
                                                    </div>
                                                }
                                                else { <span style="color:var(--fg-4)">—</span> }
                                            </td>
                                            <td class="ds-td" style="text-align:right;font-variant-numeric:tabular-nums">@AdminFormat.Money(sku.Price)</td>
                                            <td class="ds-td" style="text-align:right;color:var(--fg-3)">@sku.Tax.ToString("N1")%</td>
                                            <td class="ds-td" style="text-align:right">
                                                <button class="ds-btn ds-btn-subtle" @onclick="@(() => OpenEditSku(sku))">Edit</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        @if (_showSkuForm)
                        {
                            <div style="border-top:1px solid var(--stroke-1);padding:var(--pad-card)">
                                <div style="font-size:var(--fs-300);font-weight:var(--fw-semibold);margin-bottom:var(--sp-16)">
                                    @(_editingSkuId is null ? "New SKU" : "Edit SKU")
                                </div>
                                @if (_skuError is not null)
                                {
                                    <div style="background:var(--danger-bg);color:var(--danger);border:1px solid var(--danger);border-radius:var(--r-md);padding:var(--sp-8) var(--sp-12);margin-bottom:var(--sp-12);font-size:var(--fs-300)">
                                        @_skuError
                                    </div>
                                }
                                <div class="form-grid cols-3" style="margin-bottom:var(--sp-16)">
                                    <div class="field">
                                        <label for="sku-code" class="field-label">SKU *</label>
                                        <input id="sku-code" class="ds-input" placeholder="e.g. PRD-001-BLK" @bind="_skuForm.Sku" />
                                    </div>
                                    <div class="field">
                                        <label for="sku-name" class="field-label">Name</label>
                                        <input id="sku-name" class="ds-input" placeholder="e.g. Black / Large" @bind="_skuForm.Name" />
                                    </div>
                                    <div class="field">
                                        <label for="sku-gtin" class="field-label">Barcode (GTIN)</label>
                                        <input id="sku-gtin" class="ds-input" placeholder="e.g. 5901234123457" @bind="_skuForm.Gtin" />
                                    </div>

@*                                     <div class="field">
                                        <label for="sku-ext-ref" class="field-label">Ext ref</label>
                                        <input id="sku-ext-ref" class="ds-input" placeholder="ERP reference" @bind="_skuForm.ExtRef" />
                                    </div> *@

                                    <div class="field">
                                        <label for="sku-price" class="field-label">Price *</label>
                                        <input id="sku-price" class="ds-input" type="number" step="0.01" min="0" placeholder="0.00" @bind="_skuForm.Price" />
                                    </div>
                                    <div class="field">
                                        <label for="sku-compare-at-price" class="field-label">Compare-at price</label>
                                        <input id="sku-compare-at-price" class="ds-input" type="number" step="0.01" min="0" placeholder="0.00" @bind="_skuForm.CompareAtPrice" />
                                    </div>
                                    <div class="field">
                                        <label for="sku-cost-price" class="field-label">Cost price</label>
                                        <input id="sku-cost-price" class="ds-input" type="number" step="0.01" min="0" placeholder="0.00" @bind="_skuForm.CostPrice" />
                                    </div>
                                    <div class="field">
                                        <label for="sku-tax" class="field-label">Tax %</label>
                                        <input id="sku-tax" class="ds-input" type="number" step="0.01" min="0" max="100" placeholder="0.00" @bind="_skuForm.Tax" />
                                    </div>
                                    <div class="field">
                                        <label for="sku-stock-qty" class="field-label">Stock qty</label>
                                        <input id="sku-stock-qty" class="ds-input" type="number" min="0" placeholder="0" @bind="_skuForm.StockQuantity" />
                                    </div>
                                    <div class="field">
                                        <label for="sku-low-stock-threshold" class="field-label">Low-stock threshold</label>
                                        <input id="sku-low-stock-threshold" class="ds-input" type="number" min="0" placeholder="5" @bind="_skuForm.LowStockThreshold" />
                                    </div>
                                    @foreach (var opt in _options)
                                    {
                                        <div class="field">
                                            <label for="sku-opt-@opt.Id" class="field-label">@opt.Name</label>
                                            <select id="sku-opt-@opt.Id" class="ds-select" value="@(_skuForm.OptionSelections.TryGetValue(opt.Id, out var selVal) ? selVal.ToString() : "")" @onchange="@(e => SetSkuOption(opt.Id, e.Value?.ToString()))">
                                                <option value="">— None —</option>
                                                @foreach (var v in opt.Values)
                                                {
                                                    <option value="@v.Id">@v.Name</option>
                                                }
                                            </select>
                                        </div>
                                    }
                                </div>
                                <div class="field" style="margin-bottom:var(--sp-16)">
                                    <span class="field-label">SKU image</span>
                                    <div style="display:flex;align-items:center;gap:var(--sp-12)">
                                        @if (_skuForm.ImagePath is not null)
                                        {
                                            <div style="position:relative;width:72px;height:72px;flex-shrink:0;">
                                                <img src="@_skuForm.ImagePath" alt="SKU image"
                                                     style="width:72px;height:72px;object-fit:cover;border-radius:var(--r-md);border:1px solid var(--stroke-1);" />
                                                <button class="media-overlay-btn media-overlay-btn--danger"
                                                        style="position:absolute;top:2px;right:2px;"
                                                        title="Remove image"
                                                        @onclick="@(() => _skuForm.ImagePath = null)"
                                                        @onclick:stopPropagation="true">
                                                    <svg viewBox="0 0 20 20" fill="currentColor" width="12" height="12"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
                                                </button>
                                            </div>
                                        }
                                        <button class="ds-btn ds-btn-subtle" @onclick="@(async () => await _skuImagePicker.Show())" type="button">
                                            @(_skuForm.ImagePath is null ? "Select image…" : "Change image…")
                                        </button>
                                    </div>
                                </div>
                                <div style="display:flex;gap:var(--sp-8)">
                                    <button class="ds-btn" style="background:var(--accent-rest);color:white;border-color:var(--accent-rest)" @onclick="SaveSkuAsync" disabled="@_skuSaving">
                                        @(_skuSaving ? "Saving…" : (_editingSkuId is null ? "Add SKU" : "Update SKU"))
                                    </button>
                                    @if (_editingSkuId is not null)
                                    {
                                        @if (_confirmingSkuDelete)
                                        {
                                            <button class="ds-btn" style="color:var(--danger);border-color:var(--danger)" @onclick="DeleteSkuAsync" disabled="@_skuSaving">
                                                @(_skuSaving ? "Deleting…" : "Confirm delete")
                                            </button>
                                            <button class="ds-btn ds-btn-subtle" @onclick="@(() => _confirmingSkuDelete = false)" disabled="@_skuSaving">Keep</button>
                                        }
                                        else
                                        {
                                            <button class="ds-btn ds-btn-subtle" style="color:var(--danger)" @onclick="@(() => _confirmingSkuDelete = true)" disabled="@_skuSaving">Delete</button>
                                        }
                                    }
                                    <button class="ds-btn ds-btn-subtle" @onclick="CloseSkuForm">Cancel</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            }

            @if (_activeTab == 4)
            {
                <!-- SEO -->
                <div class="ds-card">
                    <div class="card-head">
                        <div class="card-title">Search engine preview</div>
                    </div>
                    <div style="background:var(--bg-layer-alt);border:1px solid var(--stroke-1);border-radius:var(--r-md);padding:var(--sp-16);margin-bottom:var(--sp-12)">
                        <div style="color:#1a0dab;font-size:18px;margin-bottom:4px">@(string.IsNullOrEmpty(_form.Name) ? "Product name" : _form.Name)</div>
                        <div style="color:#006621;font-size:13px;margin-bottom:4px">@PublicHost/shop/p/@(string.IsNullOrEmpty(_form.Slug) ? "product-slug" : _form.Slug)</div>
                        <div style="color:#545454;font-size:13px">@(string.IsNullOrEmpty(_form.Description) ? "Product description will appear here…" : _form.Description)</div>
                    </div>
                    <span class="field-hint">
                        Search results use the product name, URL slug and short description — edit them on the <strong>General</strong> tab.
                    </span>
                </div>
            }

        </div>

        <!-- SIDE COLUMN -->
        <div class="detail-side">

            <!-- Status card -->
            <div class="ds-card" style="padding: var(--sp-16)">
                <div style="font-size:var(--fs-300);font-weight:var(--fw-semibold);margin-bottom:var(--sp-12)">Status</div>
                <div class="field" style="margin-bottom:var(--sp-12)">
                    <label for="prod-visibility" class="field-label">Visibility</label>
                    <select id="prod-visibility" class="ds-select" value="@((int)_form.Status)" @onchange="@(e => _form.Status = (ProductStatus)int.Parse(e.Value!.ToString()!))">
                        <option value="@((int)ProductStatus.Draft)">Draft</option>
                        <option value="@((int)ProductStatus.Active)">Active — visible</option>
                        <option value="@((int)ProductStatus.Archived)">Archived</option>
                    </select>
                </div>
                <div class="ds-toggle-row">
                    <div class="ds-toggle-text">
                        <div class="ds-toggle-label">Featured on homepage</div>
                    </div>
                    <label class="ds-toggle">
                        <input type="checkbox" @bind="_form.IsFeatured" />
                        <span class="ds-toggle-track"></span>
                    </label>
                </div>
            </div>

            <!-- Organisation card -->
            <div class="ds-card" style="padding: var(--sp-16)">
                <div style="font-size:var(--fs-300);font-weight:var(--fw-semibold);margin-bottom:var(--sp-12)">Organisation</div>
                <div class="form-grid cols-1" style="gap:var(--sp-12)">
                    <div class="field">
                        <label for="prod-brand" class="field-label">Brand</label>
                        <select id="prod-brand" class="ds-select" @bind="_form.BrandId">
                            <option value="0">— No brand —</option>
                            @foreach (var b in _brands)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <span class="field-label">Categories @(_form.CategoryIds.Count > 0 ? $"({_form.CategoryIds.Count} selected)" : "")</span>
                        @if (_categories.Count == 0)
                        {
                            <span class="field-hint">No categories defined yet.</span>
                        }
                        else
                        {
                            <input class="ds-input" type="search" aria-label="Filter categories" placeholder="Filter categories…"
                                   @bind="_categoryFilter" @bind:event="oninput" />
                            <div class="pl-check-list" style="max-height:220px;overflow-y:auto">
                                @foreach (var c in VisibleCategories)
                                {
                                    var catId = c.Id;
                                    <label class="pl-check">
                                        <input type="checkbox" checked="@_form.CategoryIds.Contains(catId)"
                                               @onchange="@(e => ToggleCategory(catId, (bool)e.Value!))" />
                                        <span>@(c.ParentName is not null ? $"{c.ParentName} → {c.Name}" : c.Name)</span>
                                    </label>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (!_isNew)
            {
                <!-- Timestamps card -->
                <div class="ds-card" style="padding: var(--sp-16)">
                    <div style="font-size:var(--fs-300);font-weight:var(--fw-semibold);margin-bottom:var(--sp-12)">Details</div>
                    <div style="font-size:var(--fs-200);color:var(--fg-3);display:flex;flex-direction:column;gap:var(--sp-8)">
                        <div style="display:flex;justify-content:space-between">
                            <span>Product ID</span>
                            <span style="font-family:var(--font-mono);color:var(--fg-1)">#@Slug</span>
                        </div>
                        <div style="display:flex;justify-content:space-between">
                            <span>Images</span>
                            <span style="color:var(--fg-1)">@(_detail?.Images.Count ?? 0)</span>
                        </div>
                        <div style="display:flex;justify-content:space-between">
                            <span>Categories</span>
                            <span style="color:var(--fg-1)">@_form.CategoryIds.Count</span>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
}

@code {
	[Parameter] public string Slug { get; set; } = string.Empty;

    private bool _isNew => Slug == "new";
    private string PublicHost =>
        new Uri(Configuration["SiteUrl"] ?? "https://asgifiks.ba").Host;
    private string? PrimaryImage =>
        _skus.FirstOrDefault(s => s.ImagePath is not null)?.ImagePath
        ?? _detail?.Images.OrderBy(i => i.SortOrder).FirstOrDefault()?.Path;
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private bool _saved;
    private int _activeTab;
    private RichTextEditor? _detailEditor;

    // Flush the rich editor into the model before leaving the General tab, so edits
    // survive tab switches (the editor is unmounted when the tab is hidden).
    private async Task SetTabAsync(int tab)
    {
        if (_activeTab == 0 && tab != 0 && _detailEditor is not null)
            _form.DetailDescription = await _detailEditor.GetHtmlAsync();
        _activeTab = tab;
    }

    private ProductDetailDto? _detail;
    private List<BrandDto> _brands = [];
    private List<CategoryDto> _categories = [];
    private List<ProductSkuDto> _skus = [];
    private decimal _singleSkuPrice;
    private decimal? _singleSkuCompareAtPrice;
    private decimal? _singleSkuCostPrice;
    private int _singleSkuStock;
    private int _singleSkuLowStock;
    private bool _skuPriceSaving;
    private bool _skuPriceSaved;
    private string? _skuPriceError;
    private List<ProductOptionDto> _options = [];

    // SKU form
    private bool _showSkuForm;
    private int? _editingSkuId;
    private bool _skuSaving;
    private bool _confirmingSkuDelete;
    private int? _pendingImageIdx;
    private string? _skuError;
    private SkuFormModel _skuForm = new();

    private FormModel _form = new();

    // Slug of the product currently loaded into the form. Blazor reuses this
    // component when navigating between /products/{slug} URLs, so the product
    // is (re)loaded in OnParametersSetAsync whenever the slug changes.
    private string? _loadedSlug;

    protected override async Task OnInitializedAsync()
    {
        _brands = await Mediator.Send(new GetBrandsQuery());
        _categories = await Mediator.Send(new GetCategoriesQuery());
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Slug == _loadedSlug) return;
        _loadedSlug = Slug;

        _loading = true;
        _detail = null;
        _form = new FormModel();
        _skus = [];
        _options = [];
        _activeTab = 0;
        _showSkuForm = false;
        _pendingImageIdx = null;
        _categoryFilter = "";
        _error = null;
        _saved = false;
        _optionError = null;
        _editKind = null;
        _confirmKind = null;
        _newValue.Clear();

        if (!_isNew)
        {
            _detail = await Mediator.Send(new GetProductBySlugQuery(Slug));
            if (_detail is null)
            {
                Navigation.NavigateTo("/products");
                return;
            }
            _form = new FormModel
            {
                Name = _detail.Name,
                Sku = _detail.SKU,
                ExtRef = _detail.ExtRef,
                Slug = _detail.Slug,
                Description = _detail.Description,
                DetailDescription = _detail.DetailDescription,
                Status = _detail.Status,
                IsFeatured = _detail.IsFeatured,
                BrandId = _detail.BrandId.HasValue ? _detail.BrandId.Value : 0,
                CategoryIds = _detail.Categories.Select(c => c.Id).ToHashSet(),
            };

            var skuResult = await Mediator.Send(new GetProductSkusQuery(_detail.Id));
            _skus = skuResult.Skus;
            _options = skuResult.Options;
            SyncSingleSkuPriceFields();
        }

        _loading = false;
    }

    private async Task ReloadSkusAsync()
    {
        var result = await Mediator.Send(new GetProductSkusQuery(_detail!.Id));
        _skus = result.Skus;
        _options = result.Options;
        SyncSingleSkuPriceFields();
    }

    private void OpenAddSku()
    {
        _editingSkuId = null;
        _skuForm = new SkuFormModel();
        _skuError = null;
        _showSkuForm = true;
    }

    private void OpenEditSku(ProductSkuDto sku)
    {
        _editingSkuId = sku.Id;
        _skuForm = new SkuFormModel
        {
            Sku = sku.SKU,
            Name = sku.Name,
            ExtRef = sku.ExtRef,
            Gtin = sku.Gtin,
            Price = sku.Price,
            CompareAtPrice = sku.CompareAtPrice,
            CostPrice = sku.CostPrice,
            Tax = sku.Tax,
            StockQuantity = sku.StockQuantity,
            LowStockThreshold = sku.LowStockThreshold,
            OptionSelections = MapOptionSelections(sku),
            ImagePath = sku.ImagePath,
        };
        _skuError = null;
        _confirmingSkuDelete = false;
        _showSkuForm = true;
    }

    // The SKU DTO only carries option/value names, so resolve them to ids within
    // the matching option (value names like "Large" can repeat across options).
    private Dictionary<int, int> MapOptionSelections(ProductSkuDto sku)
    {
        var map = new Dictionary<int, int>();
        foreach (var o in sku.Options)
        {
            var option = _options.FirstOrDefault(op => op.Name == o.OptionName);
            var value = option?.Values.FirstOrDefault(v => v.Name == o.OptionValueName);
            if (option is not null && value is not null)
                map[option.Id] = value.Id;
        }
        return map;
    }

    private string _categoryFilter = "";

    // Ticked categories first (so they're visible without scrolling), then the
    // rest, narrowed by the filter box. Ticked ones always stay listed.
    private IEnumerable<CategoryDto> VisibleCategories =>
        _categories
            .Where(c => _form.CategoryIds.Contains(c.Id)
                     || string.IsNullOrWhiteSpace(_categoryFilter)
                     || c.Name.Contains(_categoryFilter, StringComparison.OrdinalIgnoreCase)
                     || (c.ParentName?.Contains(_categoryFilter, StringComparison.OrdinalIgnoreCase) ?? false))
            .OrderByDescending(c => _form.CategoryIds.Contains(c.Id));

    // ── Options management ────────────────────────────────
    private string? _optionError;
    private bool _optionBusy;
    private string _newOptionName = "";
    private bool _newOptionIsNamePart = true;
    private readonly Dictionary<int, string> _newValue = new();
    private string? _editKind;     // "option" | "value" — inline rename in progress
    private int _editId;
    private string _editText = "";
    private string? _confirmKind;  // "option" | "value" — delete awaiting confirmation
    private int _confirmId;

    // SKU DTOs carry option/value names, so usage is counted by name within this product.
    private int OptionUsage(ProductOptionDto o) => _skus.Count(s => s.Options.Any(x => x.OptionName == o.Name));
    private int ValueUsage(ProductOptionDto o, ProductOptionValueDto v) =>
        _skus.Count(s => s.Options.Any(x => x.OptionName == o.Name && x.OptionValueName == v.Name));

    private void StartEdit(string kind, int id, string text)
    {
        _editKind = kind; _editId = id; _editText = text; _confirmKind = null; _optionError = null;
    }

    private void CancelEdit() => _editKind = null;

    private void AskConfirm(string kind, int id)
    {
        _confirmKind = kind; _confirmId = id; _editKind = null; _optionError = null;
    }

    private async Task OnEditKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveEditAsync();
        else if (e.Key == "Escape") CancelEdit();
    }

    // Runs an option/value command, shows validation messages plainly, and reloads
    // options and SKUs so names and usage counts stay in step.
    private async Task<bool> RunOptionCommandAsync(Func<Task> command)
    {
        _optionError = null;
        _optionBusy = true;
        try
        {
            await command();
            await ReloadSkusAsync();
            return true;
        }
        catch (FluentValidation.ValidationException vex)
        {
            _optionError = string.Join(" ", vex.Errors.Select(e => e.ErrorMessage).Distinct());
        }
        catch (Exception ex)
        {
            _optionError = ex.Message;
        }
        finally
        {
            _optionBusy = false;
        }
        return false;
    }

    private async Task AddOptionAsync()
    {
        if (string.IsNullOrWhiteSpace(_newOptionName) || _detail is null) return;
        if (await RunOptionCommandAsync(() => Mediator.Send(new CreateProductOptionCommand(_detail.Id, _newOptionName, _newOptionIsNamePart))))
            _newOptionName = "";
    }

    private async Task AddValueAsync(int optionId)
    {
        var name = _newValue.GetValueOrDefault(optionId);
        if (string.IsNullOrWhiteSpace(name) || _detail is null) return;
        if (await RunOptionCommandAsync(() => Mediator.Send(new CreateProductOptionValueCommand(_detail.Id, optionId, name))))
            _newValue[optionId] = "";
    }

    private async Task SaveEditAsync()
    {
        if (_editKind is null || string.IsNullOrWhiteSpace(_editText)) return;
        Func<Task> command = _editKind == "option"
            ? () => Mediator.Send(new RenameProductOptionCommand(_editId, _editText))
            : () => Mediator.Send(new RenameProductOptionValueCommand(_editId, _editText));
        if (await RunOptionCommandAsync(command))
            _editKind = null;
    }

    private async Task DeleteOptionAsync(int id)
    {
        if (await RunOptionCommandAsync(() => Mediator.Send(new DeleteProductOptionCommand(id))))
            _confirmKind = null;
    }

    private async Task DeleteValueAsync(int id)
    {
        if (await RunOptionCommandAsync(() => Mediator.Send(new DeleteProductOptionValueCommand(id))))
            _confirmKind = null;
    }

    private void ToggleCategory(int id, bool selected)
    {
        if (selected) _form.CategoryIds.Add(id); else _form.CategoryIds.Remove(id);
    }

    private void CloseSkuForm()
    {
        _showSkuForm = false;
        _skuError = null;
    }

    private void SetSkuOption(int optionId, string? valueStr)
    {
        if (int.TryParse(valueStr, out var valId) && valId > 0)
            _skuForm.OptionSelections[optionId] = valId;
        else
            _skuForm.OptionSelections.Remove(optionId);
    }

    private async Task SaveSkuAsync()
    {
        _skuError = null;
        if (string.IsNullOrWhiteSpace(_skuForm.Sku)) { _skuError = "SKU code is required."; return; }

        _skuSaving = true;
        try
        {
            var optVals = _skuForm.OptionSelections.Select(kv => (kv.Key, kv.Value)).ToList();
            if (_editingSkuId is null)
            {
                await Mediator.Send(new CreateSkuCommand(_detail!.Id, _skuForm.Sku, _skuForm.ExtRef, _skuForm.Name, _skuForm.Gtin, _skuForm.Price, _skuForm.CompareAtPrice, _skuForm.CostPrice, _skuForm.Tax, _skuForm.StockQuantity, _skuForm.LowStockThreshold, _skuForm.ImagePath, optVals.Count > 0 ? optVals : null));
            }
            else
            {
                // Always send the option list so clearing an option to "None" is saved too,
                // and send "" for a removed image (null would mean "keep the current one").
                await Mediator.Send(new UpdateSkuCommand(_editingSkuId.Value, _skuForm.Sku, _skuForm.ExtRef, _skuForm.Name, _skuForm.Gtin, _skuForm.Price, _skuForm.CompareAtPrice, _skuForm.CostPrice, _skuForm.Tax, _skuForm.StockQuantity, _skuForm.LowStockThreshold, _skuForm.ImagePath ?? "", optVals));
            }
            _showSkuForm = false;
            await ReloadSkusAsync();
        }
        catch (Exception ex)
        {
            _skuError = ex.Message;
        }
        finally
        {
            _skuSaving = false;
        }
    }

    private async Task DeleteSkuAsync()
    {
        if (_editingSkuId is null) return;
        _skuSaving = true;
        try
        {
            await Mediator.Send(new DeleteSkuCommand(_editingSkuId.Value));
            _showSkuForm = false;
            await ReloadSkusAsync();
        }
        catch (Exception ex)
        {
            _skuError = ex.Message;
        }
        finally
        {
            _skuSaving = false;
            _confirmingSkuDelete = false;
        }
    }

    private async Task SaveAsync()
    {
        _error = null;
        _saved = false;

        if (string.IsNullOrWhiteSpace(_form.Name)) { _error = "Product name is required."; return; }
        if (string.IsNullOrWhiteSpace(_form.Slug)) { _error = "URL slug is required."; return; }

        // Flush the rich editor if the General tab is currently mounted.
        if (_activeTab == 0 && _detailEditor is not null)
            _form.DetailDescription = await _detailEditor.GetHtmlAsync();

        _saving = true;
        try
        {
            var brandId = _form.BrandId > 0 ? (int?)_form.BrandId : null;
            // Always a list (possibly empty) so unticking every category clears them.
            var catIds = _form.CategoryIds.ToList();

            if (_isNew)
            {
                var id = await Mediator.Send(new CreateProductCommand(
                    _form.Name, _form.Sku, _form.ExtRef, _form.Slug,
                    _form.Description, _form.Status, _form.IsFeatured, brandId, catIds));

                // CreateProductCommand has no full-description field — persist it with a follow-up update.
                if (!string.IsNullOrWhiteSpace(_form.DetailDescription))
                    await Mediator.Send(new UpdateProductCommand(
                        id, _form.Name, _form.Sku, _form.ExtRef, _form.Slug,
                        _form.Description, _form.Status, _form.IsFeatured, brandId, _form.DetailDescription, catIds));

                // The route is keyed by slug, not id; OnParametersSetAsync loads it.
                Navigation.NavigateTo($"/products/{Uri.EscapeDataString(_form.Slug)}");
            }
            else
            {
                await Mediator.Send(new UpdateProductCommand(
                    _detail!.Id, _form.Name, _form.Sku, _form.ExtRef, _form.Slug,
                    _form.Description, _form.Status, _form.IsFeatured, brandId, _form.DetailDescription, catIds));
                _saved = true;

                // Keep the address bar on the current slug so a reload still finds the product.
                // Mark it loaded first: it's the same product, so no reload is needed.
                if (_form.Slug != Slug)
                {
                    _loadedSlug = _form.Slug;
                    Navigation.NavigateTo($"/products/{Uri.EscapeDataString(_form.Slug)}", replace: true);
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private ImagePickerDialog _imagePicker = default!;
    private ImagePickerDialog _skuImagePicker = default!;

    private void SyncSingleSkuPriceFields()
    {
        if (_skus.Count == 1)
        {
            var s = _skus[0];
            _singleSkuPrice = s.Price;
            _singleSkuCompareAtPrice = s.CompareAtPrice;
            _singleSkuCostPrice = s.CostPrice;
            _singleSkuStock = s.StockQuantity;
            _singleSkuLowStock = s.LowStockThreshold;
        }
    }

    private async Task SaveSingleSkuPriceAsync()
    {
        if (_skus.Count != 1) return;
        _skuPriceError = null;
        _skuPriceSaved = false;
        _skuPriceSaving = true;
        try
        {
            var sku = _skus[0];
            await Mediator.Send(new UpdateSkuCommand(sku.Id, sku.SKU, sku.ExtRef, sku.Name, sku.Gtin,
                _singleSkuPrice, _singleSkuCompareAtPrice, _singleSkuCostPrice,
                sku.Tax, _singleSkuStock, _singleSkuLowStock, sku.ImagePath));
            await ReloadSkusAsync();
            _skuPriceSaved = true;
        }
        catch (Exception ex)
        {
            _skuPriceError = ex.Message;
        }
        finally
        {
            _skuPriceSaving = false;
        }
    }

    private async Task HandleSkuImage(List<string> filenames)
    {
        if (filenames.Count > 0)
            _skuForm.ImagePath = filenames[0];
    }

    private async Task HandleImages(List<string> filenames)
    {
        if (_detail is null || filenames.Count == 0) return;

        foreach (var filename in filenames)
        {
            var id = await Mediator.Send(new AddProductImageCommand(_detail.Id, filename, string.Empty));
            var sortOrder = _detail.Images.Count > 0 ? _detail.Images.Max(i => i.SortOrder) + 1 : 0;
            _detail.Images.Add(new ProductImageDto(id, filename, string.Empty, sortOrder));
        }
    }

    private async Task MoveImage(int index, int direction)
    {
        if (_detail is null) return;
        var target = index + direction;
        if (target < 0 || target >= _detail.Images.Count) return;
        (_detail.Images[index], _detail.Images[target]) = (_detail.Images[target], _detail.Images[index]);
        await PersistImageOrder();
    }

    private async Task RemoveImage(int index)
    {
        _pendingImageIdx = null;
        if (_detail is null) return;
        var imageId = _detail.Images[index].Id;
        _detail.Images.RemoveAt(index);
        await Mediator.Send(new DeleteProductImageCommand(imageId));
        await PersistImageOrder();
    }

    private async Task PersistImageOrder()
    {
        if (_detail is null) return;
        var orderedIds = _detail.Images.Select(i => i.Id).ToList();
        await Mediator.Send(new ReorderProductImagesCommand(orderedIds));
    }

